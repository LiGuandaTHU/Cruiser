// Generated by Cruiser: Ending Variables for Labeling the Ending of Attackers' Attacks
bool is_attacker1_end = false;

/* 模型假设：
    1.每个client上只有一个网口（mac地址、IAID）；该网口只对应一个llip，并可以DHCP申请1个gip。IAID是DHCP client网口的唯一标识，不可伪造
    2.switch上有多个port；每个port只连一个mac地址（即一个client），并通过mac_port表以报文的dstMac为依据转发报文
                         每个port作为一个anchor，可以绑定1个gip。
    3.server上通过IAID识别client接口，每个client接口（IAID）分配不超过1个gip
*/

/* client基础信息和连接关系
    MAC:[1, NUM_PORT_MAC_CLIENT]，按顺序递增
    PORT:[1, NUM_PORT_MAC_CLIENT]
    IAID:[1, NUM_PORT_MAC_CLIENT]
*/
#define MAC1 1                  //1号客户端使用的mac地址，x号客户端就使用x号mac地址。
#define PORT1 1                 //1号客户端使用的savi_switch接口编号
#define IAID1 3                 //1号客户端使用的IAID，是DHCP中客户端唯一标识
#define MAC2 2                  //2号客户端使用的mac地址，x号客户端就使用x号mac地址
#define PORT2 2                 //2号客户端使用的savi_switch接口编号
#define IAID2 4                 //2号客户端使用的IAID，是DHCP中客户端唯一标识

#define CHANNEL_SIZE 1          //通道缓冲区大小
#define NUM_PORT_MAC_CLIENT 4   //port数量、client数量、mac数量：三者相同（见模型假设1&2）
#define NUM_GLOBAL_IP 5         //可分配的所有gip数量。gip范围：[1, NUM_GLOBAL_IP]
#define MAX_GIP_PER_PORT 1      //每个port最多可绑定的gip数量，本场景下为1。（见模型假设2）

#define IPV6_ADDR_ANY 0             //IPv6地址::/128表示任意地址,用于DAD_NS的源地址
#define DHCP_SERVER_UNI_IP 101      //dhcp_server单播地址。本模型中,client->server的报文均使用该单播地址作为dstIP（虽然实际中DHCPv6请求报文也可以使用server组播地址，但本模型中只有一个server，故该建模简化是合理的）
#define DHCP_SERVER_UNI_MAC 1001    //dhcp_server的mac地址
#define ALL_NODE_MULTI_IP 102       //链路本地所有节点组播地址（用于DAD_NS的被请求节点组播地址也暂时使用该地址）
#define ALL_NODE_MULTI_MAC 1002     //多播mac地址（用于DAN_NS和NA）

bool dhcp_server_received_ping = false; //dhcp_server是否收到过PING报文
bool client_bounded = false;          //client是否成功绑定了gip

mtype:BST_state = {NO_BIND, INIT_BIND, BOUND};  //BST表项状态
mtype:Message_type = {REQUEST, CONFIRM, RELEASE, DECLINE, PING, REPLY, NOTONLINK, NOBINDING, PINGREPLY, DAD_NS, NA};    //消息类型

/* BST表项
    正常情况下，表项内容除了anchor和state外，还有DHCP分配的gip
    此处合理简化为：gip作为BST表索引，值为anchor和state。无需遍历查询，减少状态空间
*/
typedef BST_Entry {
    short anchor;    //BST锚点
    mtype:BST_state state;  //表项状态
}

// /* 消息
//     srcIP：源IP地址（llip 或 gip）
//     srcMac：源mac地址（本机mac）
//     dstIP：目的IP地址（llip或gip或组播地址）
//     dstMac：目的mac地址（服务器发包为客户端mac，客户端发包为服务器mac或ALL_NODE_MULTI_MAC——用于DAD_NS和NA）
//     target：请求分配/释放/重复检测的IP地址。PING报文内无意义
// */

/*由client & attacker1 维护的绑定地址信息*/
bool mac_isBound[NUM_PORT_MAC_CLIENT + 1];  //mac地址是否绑定了gip：索引为mac地址
short mac_gip[NUM_PORT_MAC_CLIENT + 1];   //mac绑定的gip值：索引为mac地址

/*由savi_switch维护的绑定地址信息*/
short mac_port[NUM_PORT_MAC_CLIENT + 1];    //savi_switch使用的mac转发表：索引为用户mac地址，值为对应port
BST_Entry BST[NUM_GLOBAL_IP + 1];           //savi_switch维护的BST表：索引为gip，值为对应anchor（port）和state
short port_gipNum[NUM_PORT_MAC_CLIENT + 1]; //savi_switch使用的anchor（port）绑定项数量记录表：索引为anchor（port），值为该anchor的绑定项数量（即gip数量）
short llip_port[NUM_PORT_MAC_CLIENT + 1];   //savi_switch存储的llip-port绑定关系。索引为“0 - 用户llip”，值为对应port

/*由dhcp_server维护的绑定地址信息*/
short assignedIPCount;              //分配的地址数量
short conflictIPCount;              //冲突的地址数量
short gip_IAID[NUM_GLOBAL_IP + 1];  //dhcp_server维护的gip与IAID的绑定关系：索引为gip，值为对应IAID。未分配标记为0，冲突则标记为-1
bool IAID_getgip[NUM_PORT_MAC_CLIENT + 1]; //dhcp_server维护的IAID是否绑定gip：索引为IAID，值为该IAID是否绑定了gip


chan c_sv[NUM_PORT_MAC_CLIENT + 1] = [CHANNEL_SIZE] of {mtype:Message_type, short, short, short, short, short, short};
chan sv_c[NUM_PORT_MAC_CLIENT + 1] = [CHANNEL_SIZE] of {mtype:Message_type, short, short, short, short, short, short};
chan sv_dhcp = [CHANNEL_SIZE] of {mtype:Message_type, short, short, short, short, short, short};
chan dhcp_sv = [CHANNEL_SIZE] of {mtype:Message_type, short, short, short, short, short, short};
bool clientAlive[NUM_PORT_MAC_CLIENT + 1];  //客户端进程是否存活

/*正常客户端进程
    mac：client唯一网口的mac地址
    portID：使用savi_switch接口ID
    IAID：DHCP服务中的唯一标识
*/
proctype client(short mac; short portID; short IAID) {

    mtype:Message_type msgtype;
    short srcIP_send;
    short srcMac_send;
    short dstIP_send;
    short dstMac_send;
    short target_send;
    short srcIP_recv;
    short srcMac_recv;
    short dstIP_recv;
    short dstMac_recv;
    short target_recv;
    short iaid;
    short random;

    /* gip、llip地址初始化 */
    short llip = 0 - mac;       //llip通过唯一mac地址生成：为和gip区分而取负值
    short gip = 1;
    mac_isBound[mac] = false;
    mac_gip[mac] = 0;
    clientAlive[portID] = true;

  getgip:
    atomic {
        gip = gip % NUM_GLOBAL_IP + 1; //gip从1开始，避免0值
        mac_isBound[mac] = false;
        mac_gip[mac] = 0;

        srcIP_send = llip;
        srcMac_send = mac;
        dstIP_send = DHCP_SERVER_UNI_IP;
        dstMac_send = DHCP_SERVER_UNI_MAC;
        target_send = gip;
        if
        :: c_sv[portID] ! REQUEST, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;
        :: c_sv[portID] ! CONFIRM, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;
        fi;
        goto getgip_recv;
    }
  getgip_recv:
    sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid;
    if
    :: iaid == IAID && msgtype == REPLY && target_recv == gip ->
        atomic {
            srcIP_send = IPV6_ADDR_ANY;
            srcMac_send = mac;
            dstIP_send = ALL_NODE_MULTI_IP;
            dstMac_send = ALL_NODE_MULTI_MAC;
            target_send = gip;
            c_sv[portID] ! DAD_NS, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, -1;
            goto dadns_recv;
        }
    :: iaid == IAID && msgtype == NOTONLINK && target_recv == gip ->
        goto getgip;
    :: else ->
        goto getgip_recv;
    fi;
  dadns_recv:
    if
    :: sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid ->
        if
        :: (msgtype == NA || msgtype == DAD_NS) && target_recv == gip ->
            atomic {
                srcIP_send = llip;
                srcMac_send = mac;
                dstIP_send = DHCP_SERVER_UNI_IP;
                dstMac_send = DHCP_SERVER_UNI_MAC;
                target_send = gip;
                c_sv[portID] ! DECLINE, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;
                goto decline_recv;
            }
        :: else ->
            goto dadns_recv;
        fi;
    :: timeout ->
        atomic {
            mac_isBound[mac] = true;
            mac_gip[mac] = gip;
            client_bounded = true;
            printf("\nClient Mac %d from port %d is bound to global IP %d\n", mac, portID, gip);
        }
        if
        :: goto release;
        :: goto progressClient;
        fi;
    fi;
  decline_recv:
    sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid;
    if
    :: iaid == IAID && (msgtype == REPLY || msgtype == NOBINDING) && target_recv == gip ->
        goto getgip;
    :: else ->
        goto decline_recv;
    fi;
  release:
    atomic {
        srcIP_send = llip;
        srcMac_send = mac;
        dstIP_send = DHCP_SERVER_UNI_IP;
        dstMac_send = DHCP_SERVER_UNI_MAC;
        target_send = gip;
        c_sv[portID] ! RELEASE, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;

        mac_isBound[mac] = false;
        mac_gip[mac] = 0;
        printf("\nClient Mac %d from port %d release global IP %d\n", mac, portID, gip);
        goto release_recv;
    }
  release_recv:
    sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid;
    if
    :: iaid == IAID && (msgtype == REPLY || msgtype == NOBINDING) && target_recv == gip ->
        atomic {
            if
            :: goto getgip;
            :: goto stop;
            fi;
        }
    :: else ->
        goto release_recv;
    fi;
  endclient:
  progressClient:
    do
    :: sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid ->
        if
        :: msgtype == DAD_NS && target_recv == gip && mac_isBound[mac] ->
            atomic {
                srcIP_send = target_recv;
                srcMac_send = mac;
                dstIP_send = ALL_NODE_MULTI_IP;
                dstMac_send = ALL_NODE_MULTI_MAC;
                target_send = target_recv;
                c_sv[portID] ! NA, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, -1;
            }
        :: else ->
            printf("\nClient Mac %d receive a %e message, but no process\n", mac, msgtype);
        fi;
    :: timeout ->
        goto release;
    od;
  stop:
    atomic {
        clientAlive[portID] = false;
        printf("\nClient %d stop\n", portID);
    }
}

proctype attacker1(short mac; short portID; short IAID) {

    mtype:Message_type msgtype;
    short srcIP_send;
    short srcMac_send;
    short dstIP_send;
    short dstMac_send;
    short target_send;
    short srcIP_recv;
    short srcMac_recv;
    short dstIP_recv;
    short dstMac_recv;
    short target_recv;
    short iaid;
    short random;

    /* gip、llip地址初始化 */
    short llip = 0 - mac;       //llip通过唯一mac地址生成：为和gip区分而取负值
    short gip = 5;
    mac_isBound[mac] = false;
    mac_gip[mac] = 0;
    clientAlive[portID] = true;

  getgip:
    atomic {
        gip = gip % NUM_GLOBAL_IP + 1; //gip从1开始，避免0值
        mac_isBound[mac] = false;
        mac_gip[mac] = 0;

        srcIP_send = llip;
        srcMac_send = mac;
        dstIP_send = DHCP_SERVER_UNI_IP;
        dstMac_send = DHCP_SERVER_UNI_MAC;
        target_send = gip;
        if
        :: c_sv[portID] ! REQUEST, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;
        :: c_sv[portID] ! CONFIRM, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;
        fi;
        goto getgip_recv;
    }
  getgip_recv:
    sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid;
    if
    :: iaid == IAID && msgtype == REPLY && target_recv == gip ->
        atomic {
            srcIP_send = IPV6_ADDR_ANY;
            srcMac_send = mac;
            dstIP_send = ALL_NODE_MULTI_IP;
            dstMac_send = ALL_NODE_MULTI_MAC;
            target_send = gip;
            c_sv[portID] ! DAD_NS, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, -1;
            goto dadns_recv;
        }
    :: iaid == IAID && msgtype == NOTONLINK && target_recv == gip ->
        goto getgip;
    :: else ->
        goto getgip_recv;
    fi;
  dadns_recv:
    if
    :: sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, _ ->
        if
        :: (msgtype == NA || msgtype == DAD_NS) && target_recv == gip ->
            atomic {
                srcIP_send = llip;
                srcMac_send = mac;
                dstIP_send = DHCP_SERVER_UNI_IP;
                dstMac_send = DHCP_SERVER_UNI_MAC;
                target_send = gip;
                c_sv[portID] ! DECLINE, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, IAID;
                goto decline_recv;
            }
        :: else ->
            goto dadns_recv;
        fi;
    :: timeout ->
        atomic {
            mac_isBound[mac] = true;
            mac_gip[mac] = gip;
            printf("\nAttacker1 Mac %d from port %d is bound to global IP %d\n, now to attack!!!!", mac, portID, gip);
        }
        goto CruiserPoint;
    fi;
  decline_recv:
    sv_c[portID] ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid;
    if
    :: iaid == IAID && (msgtype == REPLY || msgtype == NOBINDING) && target_recv == gip ->
        goto getgip;
    :: else ->
        goto decline_recv;
    fi;
  CruiserPoint:
	// Auto-generated Promela Code for attacker.
	// Variable Declarations
	skip;
	mtype:Message_type sv_c_portID__type_recv, c_sv_portID__type_send, c_sv_1__type_SNIFFINGCACHE;
	short sv_c_portID__srcIP_recv, sv_c_portID__srcMac_recv, sv_c_portID__dstIP_recv, sv_c_portID__dstMac_recv, sv_c_portID__target_recv, sv_c_portID__iaid_recv, c_sv_portID__srcIP_send, c_sv_portID__srcMac_send, c_sv_portID__dstIP_send, c_sv_portID__dstMac_send, c_sv_portID__target_send, c_sv_portID__iaid_send, c_sv_1__srcIP_SNIFFINGCACHE, c_sv_1__srcMac_SNIFFINGCACHE, c_sv_1__dstIP_SNIFFINGCACHE, c_sv_1__dstMac_SNIFFINGCACHE, c_sv_1__target_SNIFFINGCACHE, c_sv_1__iaid_SNIFFINGCACHE;
	bool is_c_sv_1__SNIFFING_cached = false;

	// Attack Behavior
	AttackStart:
	do
	// INTERCEPTION on channel sv_c[portID] with no filter
	:: atomic { sv_c[portID] ? sv_c_portID__type_recv, sv_c_portID__srcIP_recv, sv_c_portID__srcMac_recv, sv_c_portID__dstIP_recv, sv_c_portID__dstMac_recv, sv_c_portID__target_recv, sv_c_portID__iaid_recv;
	   }
	// SNIFFING on channel c_sv[1] with no filter
	:: atomic { c_sv[1] ? <c_sv_1__type_SNIFFINGCACHE, c_sv_1__srcIP_SNIFFINGCACHE, c_sv_1__srcMac_SNIFFINGCACHE, c_sv_1__dstIP_SNIFFINGCACHE, c_sv_1__dstMac_SNIFFINGCACHE, c_sv_1__target_SNIFFINGCACHE, c_sv_1__iaid_SNIFFINGCACHE> ->
		is_c_sv_1__SNIFFING_cached = true;
	   }
	// INJECTION on channel c_sv[portID]
	:: atomic { is_c_sv_1__SNIFFING_cached && nfull(c_sv[portID]) ->
		if
		:: c_sv_portID__type_send = REQUEST;
		:: c_sv_portID__type_send = RELEASE;
		:: c_sv_portID__type_send = DECLINE;
		fi;
		c_sv_portID__srcIP_send = c_sv_1__srcIP_SNIFFINGCACHE;
		c_sv_portID__srcMac_send = mac;
		c_sv_portID__dstIP_send = DHCP_SERVER_UNI_IP;
		c_sv_portID__dstMac_send = DHCP_SERVER_UNI_MAC;
		c_sv_portID__target_send = c_sv_1__target_SNIFFINGCACHE;
		c_sv_portID__iaid_send = IAID;
		c_sv[portID] ! c_sv_portID__type_send, c_sv_portID__srcIP_send, c_sv_portID__srcMac_send, c_sv_portID__dstIP_send, c_sv_portID__dstMac_send, c_sv_portID__target_send, c_sv_portID__iaid_send;
	   }
	:: break;
	:: goto AttackEnd;
	od;
	if
	:: timeout -> goto AttackStart;
	fi;
	AttackEnd:
	is_attacker1_end = true;
}

proctype dhcp_server() {
    mtype:Message_type msgtype;
    short srcIP_send;
    short srcMac_send;
    short dstIP_send;
    short dstMac_send;
    short target_send;
    short srcIP_recv;
    short srcMac_recv;
    short dstIP_recv;
    short dstMac_recv;
    short target_recv;
    short iaid;
    srcIP_send = DHCP_SERVER_UNI_IP;
    srcMac_send = DHCP_SERVER_UNI_MAC;

  endServer:
    do
    :: sv_dhcp ? msgtype, srcIP_recv, srcMac_recv, dstIP_recv, dstMac_recv, target_recv, iaid ->
        atomic {
            dstIP_send = srcIP_recv;
            dstMac_send = srcMac_recv;
            target_send = target_recv;
            if
            :: msgtype == REQUEST || msgtype == CONFIRM->
                if
                :: ! IAID_getgip[iaid] ->
                    if
                    :: gip_IAID[target_recv] != 0 ->
                        dhcp_sv ! NOTONLINK, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, iaid;
                    :: gip_IAID[target_recv] == 0 ->
                        assignedIPCount++;
                        gip_IAID[target_recv] = iaid;
                        IAID_getgip[iaid] = true;
                        dhcp_sv ! REPLY, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, iaid;
                    fi;
                :: else -> skip;
                fi;
            :: msgtype == RELEASE ->
                if
                :: gip_IAID[target_recv] == iaid ->
                    assignedIPCount--;
                    gip_IAID[target_recv] = 0;
                    IAID_getgip[iaid] = false;
                    dhcp_sv ! REPLY, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, iaid;
                :: gip_IAID[target_recv] != iaid ->
                    dhcp_sv ! NOBINDING, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, iaid;
                fi;
            :: msgtype == DECLINE ->
                if
                :: gip_IAID[target_recv] == iaid ->
                    assignedIPCount--;
                    conflictIPCount++;
                    gip_IAID[target_recv] = -1;
                    IAID_getgip[iaid] = false;
                    dhcp_sv ! REPLY, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, iaid;
                :: gip_IAID[target_recv] != iaid ->
                    dhcp_sv ! NOBINDING, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, iaid;
                fi;
            :: msgtype == PING ->
                dhcp_server_received_ping = true;
                dhcp_sv ! PINGREPLY, srcIP_send, srcMac_send, dstIP_send, dstMac_send, target_send, -1;
            :: else ->
                printf("\nInvalid message received by DHCP server\n");
            fi;
        }
    od;
}

proctype savi_switch(short port1; short port2) {
    mtype:Message_type msgtype;
    short srcIP;
    short srcMac;
    short dstIP;
    short dstMac;
    short target;
    short iaid;
    short recv_portID, send_portID;

  endSwitch:
  progressSwitch:
    /*每次收到client接口的消息，先验证其合法性，再转换table状态，最后转发出去;
      收到server接口的消息时，无需验证，转换table状态后直接转发
    */
    do
    // 从port1接收消息
    :: c_sv[port1] ? msgtype, srcIP, srcMac, dstIP, dstMac, target, iaid ->
        atomic {
            recv_portID = port1;
            send_portID = port2;
            goto dealClientMsg;
        }
    :: c_sv[port2] ? msgtype, srcIP, srcMac, dstIP, dstMac, target, iaid ->
        atomic {
            recv_portID = port2;
            send_portID = port1;
            goto dealClientMsg;
        }
  dealClientMsg:
        atomic {
            if
            :: msgtype == REQUEST || msgtype == CONFIRM ->
                if
                :: port_gipNum[recv_portID] < MAX_GIP_PER_PORT && BST[target].state == NO_BIND ->
                    BST[target].anchor = recv_portID;
                    BST[target].state = INIT_BIND;
                fi;
                goto fwdClientMsg;
            :: msgtype == DECLINE || msgtype == RELEASE ->
                if
                :: BST[target].state == BOUND && BST[target].anchor == recv_portID ->
                    BST[target].anchor = 0;
                    BST[target].state = NO_BIND;
                    port_gipNum[recv_portID]--;
                fi;
                goto fwdClientMsg;
            :: msgtype == DAD_NS ->
                goto fwdClientMsg;
            :: msgtype == NA ->
                if
                :: (srcIP < 0 && llip_port[0 - srcIP] == recv_portID) || (target > 0 && BST[target].anchor == recv_portID && BST[target].state == BOUND) ->
                    goto fwdClientMsg;
                :: else ->
                    goto progressSwitch;
                fi;
            :: msgtype == PING ->
                if
                :: (srcIP < 0 && llip_port[0 - srcIP] == recv_portID) || (srcIP > 0 && BST[srcIP].anchor == recv_portID && BST[srcIP].state == BOUND) ->
                    goto fwdClientMsg;
                :: else ->
                    goto progressSwitch;
                fi;
            :: else ->
                printf("\nInvalid message send by Client from port %d\n", recv_portID);
            fi;
        }
  fwdClientMsg:
        atomic {
            if
            :: dstMac == DHCP_SERVER_UNI_MAC ->
                sv_dhcp ! msgtype, srcIP, srcMac, dstIP, dstMac, target, iaid;
            :: dstMac == ALL_NODE_MULTI_MAC && clientAlive[send_portID]->
                sv_c[send_portID] ! msgtype, srcIP, srcMac, dstIP, dstMac, target, iaid;
            :: else -> skip;
            fi;
        }
    // 从dhcp_server接收消息
    :: dhcp_sv ? msgtype, srcIP, srcMac, dstIP, dstMac, target, iaid ->
        atomic {
            if
            :: msgtype == REPLY ->
                if
                :: BST[target].state == INIT_BIND ->
                    BST[target].state = BOUND;
                    port_gipNum[BST[target].anchor]++;
                :: else -> skip;
                fi;
            :: msgtype == NOTONLINK ->
                if
                :: BST[target].state == INIT_BIND ->
                    BST[target].anchor = 0;
                    BST[target].state = NO_BIND;
                :: else -> skip;
                fi;
            :: msgtype == NOBINDING || msgtype == PINGREPLY -> skip;
            :: else ->
                printf("\nInvalid message send by DHCP server\n");
                goto progressSwitch;
            fi;
            sv_c[mac_port[dstMac]] ! msgtype, srcIP, srcMac, dstIP, dstMac, target, iaid;
        }
    od;
}

init {
    assignedIPCount = 0;
    conflictIPCount = 0;

    short i = 0;
    do
    ::  i <= NUM_PORT_MAC_CLIENT ->
        mac_isBound[i] = false;
        mac_gip[i] = 0;
        port_gipNum[i] = 0;
        IAID_getgip[i] = false;
        i = i + 1;
    :: else -> break;
    od;
    i = 0;
    do
    :: i <= NUM_GLOBAL_IP ->
        BST[i].anchor = 0;
        BST[i].state = NO_BIND;
        gip_IAID[i] = 0;
        i = i + 1;
    :: else -> break;
    od;

    mac_port[MAC1] = PORT1;
    mac_port[MAC2] = PORT2;
    llip_port[0 - (0 - MAC1)] = PORT1;
    llip_port[0 - (0 - MAC2)] = PORT2;

    run dhcp_server();
    run savi_switch(PORT1, PORT2);
    run client(MAC1, PORT1, IAID1);
    run attacker1(MAC2, PORT2, IAID2);
}
ltl phi2 {
   (eventually (is_attacker1_end)) implies ( // LTL Properties to be Checked
	eventually ( client_bounded )
)
}